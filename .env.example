# Leave these unset to use the local SQLite file at data/skrappily.db.
# On Vercel, point them at a Turso (libSQL) database. Turso's free plan is enough.
# TURSO_DATABASE_URL and TURSO_AUTH_TOKEN are accepted aliases.
# DATABASE_URL is accepted only when it is a libsql:// or file: URL.
LIBSQL_URL=
LIBSQL_AUTH_TOKEN=

# Set to false before the first boot if you do not want the San Diego example listings.
SEED_EXAMPLE_DATA=

# Photos. local is the default and stores files in data/uploads.
# On Vercel the filesystem does not persist, so use blob plus a Blob read-write token.
# If BLOB_READ_WRITE_TOKEN is set and STORAGE_PROVIDER is empty, blob is selected.
STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=

# RFQ/quote attachments (and photos) use Vercel Blob when BLOB_READ_WRITE_TOKEN
# is set. Create a PRIVATE Blob store and connect it to the project; files are
# only served through the app after a session check. BLOB_ACCESS defaults to
# private; set it to public only if your store is public.
BLOB_ACCESS=

# Payments (Stripe Connect, RFQ quotes only). Leave STRIPE_SECRET_KEY empty to
# hide all pay buttons. Use sandbox/test keys (sk_test_...) until launch.
STRIPE_SECRET_KEY=
# Signing secret for the platform webhook endpoint (checkout + charge events).
STRIPE_WEBHOOK_SECRET=
# Signing secret for the connected-accounts webhook endpoint (account.updated).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Optional: absolute site URL for Stripe redirects; defaults to the request host.
NEXT_PUBLIC_SITE_URL=
# Skrappily's cut of each payment, in percent. Default 1.
PLATFORM_FEE_PERCENT=1
# Default true: the buyer pays a "Card processing fee" line so card costs
# don't come out of the seller or the platform fee. Set false to absorb it.
STRIPE_PASS_THROUGH_CARD_FEES=true
# Stripe's US card pricing used for the gross-up. Update if your rate differs.
STRIPE_CARD_FEE_PERCENT=2.9
STRIPE_CARD_FEE_FIXED_CENTS=30
